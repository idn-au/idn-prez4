PREFIX altr-ext: <http://www.w3.org/ns/dx/connegp/altr-ext#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX prez: <https://prez.dev/>
PREFIX prof: <http://www.w3.org/ns/dx/prof/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX shext: <http://example.com/shacl-extension#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

prez:ProfilesGraph {
    # top-level profile for specifying default profiles
    prez:CustomIndexProfile
        a prof:Profile , prez:IndexProfile ;
        dcterms:identifier "idn"^^xsd:token ;
        dcterms:description "A system profile for IDN" ;
        dcterms:title "IDN Index Profile" ;
        altr-ext:constrainsClass prez:CatPrez ;
        altr-ext:hasDefaultResourceFormat "text/anot+turtle" ;
        altr-ext:hasNodeShape
            [
                a sh:NodeShape ;
                sh:targetClass skos:ConceptScheme ;
                altr-ext:hasDefaultProfile prez:ConceptSchemesListProfile ;
            ],
            [
                a sh:NodeShape ;
                altr-ext:hasDefaultProfile prez:CustomFeatureListProfile ;
                sh:targetClass
                    geo:FeatureCollection ,
                    geo:Feature ;
            ] ,
            [
                a sh:NodeShape ;
                altr-ext:hasDefaultProfile prez:CustomFeatureObjectProfile ;
                sh:targetClass
                    geo:FeatureCollection ,
                    geo:Feature ;
            ] ,
            [
                a sh:NodeShape ;
                sh:targetClass prez:CQLFilterResult ;
                altr-ext:hasDefaultProfile prez:CustomCQLListProfile ;
            ] ;
        altr-ext:hasResourceFormat
            "application/json",
            "application/ld+json",
            "application/rdf+xml",
            "text/anot+turtle",
            "text/turtle" ;
    .

    # regular profiles

    prez:ConceptSchemesListProfile
        a prof:Profile, prez:ListingProfile, sh:NodeShape ;
        dcterms:title "Concept Scheme Listing Profile" ;
        dcterms:description "A profile for listing SKOS Concept Schemes" ;
        dcterms:identifier "vocab-list"^^xsd:token ;
        altr-ext:hasResourceFormat
            "application/ld+json",
            "application/anot+ld+json",
            "application/rdf+xml",
            "text/anot+turtle",
            "text/turtle" ;
        altr-ext:hasDefaultResourceFormat "text/anot+turtle" ;
        altr-ext:constrainsClass skos:ConceptScheme , prez:CQLFilterResult ;
        sh:property [
            sh:path [
                sh:union (
                    schema:additionalType
                    schema:publisher
                    schema:status
                    schema:keywords
                )
            ]
        ] ;
    .

    prez:CustomFeatureListProfile
        a prof:Profile, prez:ListingProfile, sh:NodeShape ;
        dcterms:title "Custom Feature List Profile" ;
        dcterms:description "A custom list profile for GeoSPARQL Features" ;
        dcterms:identifier "custom-feature-list"^^xsd:token ;
        altr-ext:hasResourceFormat
            "application/ld+json",
            "application/anot+ld+json",
            "application/rdf+xml",
            "text/anot+turtle",
            "text/turtle",
            "application/n-triples" ;
        altr-ext:hasDefaultResourceFormat "text/anot+turtle" ;
        sh:property [ sh:path rdf:type ] ;
        altr-ext:constrainsClass
            geo:FeatureCollection ,
            geo:Feature ;
    .

    prez:CustomFeatureObjectProfile
        a prof:Profile, prez:ObjectProfile, sh:NodeShape ;
        dcterms:title "Custom Feature Object Profile" ;
        dcterms:description "A custom object profile for GeoSPARQL Features" ;
        dcterms:identifier "custom-feature-object"^^xsd:token ;
        altr-ext:hasResourceFormat
            "application/ld+json",
            "application/anot+ld+json",
            "application/rdf+xml",
            "text/anot+turtle",
            "text/turtle",
            "application/n-triples" ;
        altr-ext:hasDefaultResourceFormat "text/anot+turtle" ;
        sh:property
            [
                sh:path [
                    sh:union (
                        [ shext:bNodeDepth "2" ]
                        shext:allPredicateValues
                        ( geo:hasBoundingBox geo:asWKT )
                        ( geo:hasGeometry geo:asWKT )
                        ( [ sh:inversePath rdfs:member ] rdf:type )
                        ( [ sh:inversePath rdfs:member ] schema:isPartOf )
                    )
                ] ;
            ] ,
            [
                sh:maxCount 0 ;
                sh:path rdfs:member ;
            ] ;
        altr-ext:constrainsClass
            geo:FeatureCollection ,
            geo:Feature ;
    .

    prez:CustomCQLListProfile
        a prof:Profile , prez:ListingProfile ;
        dcterms:identifier "cqllist"^^xsd:token ;
        dcterms:description "A CQL profile targeted towards listing CQL results, including geospatial information." ;
        dcterms:title "CQL List profile" ;
        altr-ext:constrainsClass prez:CQLFilterResult ;
        altr-ext:hasDefaultResourceFormat "text/anot+turtle" ;
        altr-ext:hasResourceFormat "application/geo+json" ,
            "application/ld+json" ,
            "application/anot+ld+json" ,
            "application/rdf+xml" ,
            "text/anot+turtle" ,
            "text/turtle" ;
        sh:property [
            sh:path [
                sh:union (
                    [ shext:bNodeDepth "2" ]
                    shext:allPredicateValues
                    ( geo:hasGeometry geo:asWKT )
                )
            ]
        ] ;
    .

    # facet profiles

    prez:FacetProfile
        a prof:Profile, prez:ListingProfile, sh:NodeShape ;
        dcterms:title "Custom Facet Profile" ;
        dcterms:description "A custom facet profile for the IDN" ;
        dcterms:identifier "idn-facet"^^xsd:token ;
        sh:property [
            sh:path [
                sh:union (
                    rdf:type
                    schema:status
                    # [
                    #     sh:path ( [ sh:inversePath schema:hasPart ] ) ;
                    #     # sh:alternativePath
                    #     shext:pathAlias <https://example.com/alias/isPartOf> ;
                    # ]
                )
            ]
        ] ;
    .

    # <https://example.com/alias/isPartOf> rdfs:label "is part of" .
}