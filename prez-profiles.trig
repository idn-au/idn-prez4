PREFIX altr-ext: <http://www.w3.org/ns/dx/connegp/altr-ext#>
PREFIX atns: <https://linked.data.gov.au/def/atns/model/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX odrl: <http://www.w3.org/ns/odrl/2/>
PREFIX prez: <https://prez.dev/>
PREFIX prof: <http://www.w3.org/ns/dx/prof/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rico: <https://www.ica.org/standards/RiC/ontology#>
PREFIX schema: <https://schema.org/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX shext: <http://example.com/shacl-extension#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

prez:ProfilesGraph {
    # top-level profile for specifying default profiles
    prez:CustomIndexProfile
        a prof:Profile , prez:IndexProfile ;
        dcterms:identifier "idn"^^xsd:token ;
        dcterms:description "A system profile for IDN" ;
        dcterms:title "IDN Index Profile" ;
        altr-ext:constrainsClass prez:CatPrez ;
        altr-ext:hasDefaultResourceFormat "text/anot+turtle" ;
        altr-ext:hasNodeShape
            [
                a sh:NodeShape ;
                sh:targetClass skos:ConceptScheme ;
                altr-ext:hasDefaultProfile prez:ConceptSchemesListProfile ;
            ],
            [
                a sh:NodeShape ;
                altr-ext:hasDefaultProfile prez:CustomFeatureListProfile ;
                sh:targetClass
                    geo:FeatureCollection ,
                    geo:Feature ;
            ] ,
            [
                a sh:NodeShape ;
                altr-ext:hasDefaultProfile prez:CustomFeatureObjectProfile ;
                sh:targetClass
                    geo:FeatureCollection ,
                    geo:Feature ;
            ] ,
            [
                a sh:NodeShape ;
                sh:targetClass prez:CQLFilterResult ;
                altr-ext:hasDefaultProfile prez:CustomCQLListProfile ;
            ] ,
            [
                a sh:NodeShape ;
                sh:targetClass odrl:Agreement ;
                altr-ext:hasDefaultProfile prez:odrl-agreement ;
            ] ,
            [
                a sh:NodeShape ;
                sh:targetClass atns:Entity ;
                altr-ext:hasDefaultProfile prez:AtnsEntityProfile ;
            ] ,
            [
                a sh:NodeShape ;
                sh:targetClass rico:Record ;
                altr-ext:hasDefaultProfile prez:RiCORecordProfile ;
            ] ;
        altr-ext:hasResourceFormat
            "application/json",
            "application/ld+json",
            "application/rdf+xml",
            "text/anot+turtle",
            "text/turtle" ;
    .

    # regular profiles

    prez:ConceptSchemesListProfile
        a prof:Profile, prez:ListingProfile, sh:NodeShape ;
        dcterms:title "Concept Scheme Listing Profile" ;
        dcterms:description "A profile for listing SKOS Concept Schemes" ;
        dcterms:identifier "vocab-list"^^xsd:token ;
        altr-ext:hasResourceFormat
            "application/ld+json",
            "application/anot+ld+json",
            "application/rdf+xml",
            "text/anot+turtle",
            "text/turtle" ;
        altr-ext:hasDefaultResourceFormat "text/anot+turtle" ;
        altr-ext:constrainsClass skos:ConceptScheme , prez:CQLFilterResult ;
        sh:property [
            sh:path [
                sh:union (
                    schema:additionalType
                    schema:publisher
                    schema:status
                    schema:keywords
                )
            ]
        ] ;
    .

    prez:CustomFeatureListProfile
        a prof:Profile, prez:ListingProfile, sh:NodeShape ;
        dcterms:title "Custom Feature List Profile" ;
        dcterms:description "A custom list profile for GeoSPARQL Features" ;
        dcterms:identifier "custom-feature-list"^^xsd:token ;
        altr-ext:hasResourceFormat
            "application/ld+json",
            "application/anot+ld+json",
            "application/rdf+xml",
            "text/anot+turtle",
            "text/turtle",
            "application/n-triples" ;
        altr-ext:hasDefaultResourceFormat "text/anot+turtle" ;
        sh:property [ sh:path rdf:type ] ;
        altr-ext:constrainsClass
            geo:FeatureCollection ,
            geo:Feature ;
    .

    prez:CustomFeatureObjectProfile
        a prof:Profile, prez:ObjectProfile, sh:NodeShape ;
        dcterms:title "Custom Feature Object Profile" ;
        dcterms:description "A custom object profile for GeoSPARQL Features" ;
        dcterms:identifier "custom-feature-object"^^xsd:token ;
        altr-ext:hasResourceFormat
            "application/ld+json",
            "application/anot+ld+json",
            "application/rdf+xml",
            "text/anot+turtle",
            "text/turtle",
            "application/n-triples" ;
        altr-ext:hasDefaultResourceFormat "text/anot+turtle" ;
        sh:property
            [
                sh:path [
                    sh:union (
                        [ shext:bNodeDepth "2" ]
                        shext:allPredicateValues
                        ( geo:hasBoundingBox geo:asWKT )
                        ( geo:hasGeometry geo:asWKT )
                        ( [ sh:inversePath rdfs:member ] rdf:type )
                        ( [ sh:inversePath rdfs:member ] schema:isPartOf )
                    )
                ] ;
            ] ,
            [
                sh:maxCount 0 ;
                sh:path rdfs:member ;
            ] ;
        altr-ext:constrainsClass
            geo:FeatureCollection ,
            geo:Feature ;
    .

    prez:CustomCQLListProfile
        a prof:Profile , prez:ListingProfile ;
        dcterms:identifier "cqllist"^^xsd:token ;
        dcterms:description "A CQL profile targeted towards listing CQL results, including geospatial information." ;
        dcterms:title "CQL List profile" ;
        altr-ext:constrainsClass prez:CQLFilterResult ;
        altr-ext:hasDefaultResourceFormat "text/anot+turtle" ;
        altr-ext:hasResourceFormat "application/geo+json" ,
            "application/ld+json" ,
            "application/anot+ld+json" ,
            "application/rdf+xml" ,
            "text/anot+turtle" ,
            "text/turtle" ;
        sh:property [
            sh:path [
                sh:union (
                    [ shext:bNodeDepth "2" ]
                    shext:allPredicateValues
                    ( geo:hasGeometry geo:asWKT )
                )
            ]
        ] ;
    .

    prez:odrl-agreement
        a prof:Profile , prez:ObjectProfile ;
        dcterms:identifier "odrl-agreement"^^xsd:token ;
        dcterms:title "ODRL Agreement presentation profile"@en ;
        dcterms:description "Presents an ODRL Agreement with its named Permission rules and their actions, parties and targets."@en ;
        altr-ext:constrainsClass odrl:Agreement ;
        altr-ext:hasDefaultResourceFormat "text/anot+turtle" ;
        altr-ext:hasResourceFormat
            "application/anot+ld+json" ,
            "application/ld+json" ,
            "text/anot+turtle" ,
            "text/turtle" ;
        sh:property [
            sh:path [
                sh:union (
                    rdf:type
                    dcterms:title
                    schema:name
                    odrl:permission
                    ( odrl:permission rdf:type )
                    ( odrl:permission dcterms:title )
                    ( odrl:permission schema:name )
                    ( odrl:permission odrl:action )
                    ( odrl:permission odrl:assigner )
                    ( odrl:permission odrl:assignee )
                    ( odrl:permission odrl:target )
                )
            ]
        ] ;
    .

    prez:AtnsEntityProfile
        a prof:Profile , prez:ObjectProfile ;
        dcterms:identifier "atns-entity"^^xsd:token ;
        dcterms:title "ATNS Entity presentation profile"@en ;
        dcterms:description "Presents an ATNS entity with its descriptive metadata, references, relationships, reviewed attributions and spatial coverage. A linked spatial feature's name and geometry are requested for an on-demand map without treating the feature as an ODRL target."@en ;
        altr-ext:constrainsClass atns:Entity ;
        altr-ext:hasDefaultResourceFormat "text/anot+turtle" ;
        altr-ext:hasResourceFormat
            "application/anot+ld+json" ,
            "application/ld+json" ,
            "text/anot+turtle" ,
            "text/turtle" ;
        sh:property [
            sh:path [
                sh:union (
                    shext:allPredicateValues
                    ( schema:spatialCoverage rdf:type )
                    ( schema:spatialCoverage schema:name )
                    ( schema:spatialCoverage schema:description )
                    ( schema:spatialCoverage geo:hasGeometry )
                    ( schema:spatialCoverage geo:hasGeometry geo:asWKT )
                    ( schema:spatialCoverage geo:hasBoundingBox )
                    ( schema:spatialCoverage geo:hasBoundingBox geo:asWKT )
                    ( prov:qualifiedAttribution rdf:type )
                    ( prov:qualifiedAttribution schema:agent )
                    ( prov:qualifiedAttribution schema:roleName )
                    ( prov:qualifiedAttribution schema:agent rdf:type )
                    ( prov:qualifiedAttribution schema:agent schema:name )
                    ( dcterms:references rdf:type )
                    ( dcterms:references atns:referenceType )
                    ( dcterms:references schema:name )
                    ( dcterms:references schema:url )
                    ( [ sh:inversePath atns:subjectEntity ] rdf:type )
                    ( [ sh:inversePath atns:subjectEntity ] atns:relationshipType )
                    ( [ sh:inversePath atns:subjectEntity ] atns:objectEntity )
                    ( [ sh:inversePath atns:objectEntity ] rdf:type )
                    ( [ sh:inversePath atns:objectEntity ] atns:relationshipType )
                    ( [ sh:inversePath atns:objectEntity ] atns:subjectEntity )
                )
            ]
        ] ;
    .

    prez:OdrlAgreement
        a prof:Profile , prez:ObjectProfile ;
        dcterms:identifier "odrl-agreement"^^xsd:token ;
        dcterms:title "ODRL Agreement presentation profile"@en ;
        dcterms:description "Presents an ODRL Agreement with its named Permission rules and their actions, parties and targets."@en ;
        altr-ext:constrainsClass odrl:Agreement ;
        altr-ext:hasDefaultResourceFormat "text/anot+turtle" ;
        altr-ext:hasResourceFormat
            "application/anot+ld+json" ,
            "application/ld+json" ,
            "text/anot+turtle" ,
            "text/turtle" ;
        sh:property [
            sh:path [
                sh:union (
                    shext:allPredicateValues
                    rdf:type
                    dcterms:title
                    schema:name
                    odrl:permission
                    ( odrl:permission rdf:type )
                    ( odrl:permission dcterms:title )
                    ( odrl:permission schema:name )
                    ( odrl:permission odrl:action )
                    ( odrl:permission odrl:assigner )
                    ( odrl:permission odrl:assignee )
                    ( odrl:permission odrl:target )
                )
            ]
        ] ;
    .

    _:ricoInstantiationPath
        sh:alternativePath (
            rico:hasOrHadInstantiation
            rico:hasOrHadAnalogueInstantiation
            rico:hasOrHadDigitalInstantiation
            rico:hasOrHadDerivedInstantiation
        ) ;
    .

    prez:RiCORecordProfile
        a prof:Profile , prez:ObjectProfile , sh:NodeShape ;
        dcterms:identifier "rico-record"^^xsd:token ;
        dcterms:title "RiC-O Record presentation profile"@en ;
        dcterms:description "Presents a RiC-O Record and the descriptive metadata of its analogue, digital, derived or otherwise identified Instantiations on the same page."@en ;
        altr-ext:constrainsClass rico:Record ;
        altr-ext:hasDefaultResourceFormat "text/anot+turtle" ;
        altr-ext:hasResourceFormat
            "application/anot+ld+json" ,
            "application/ld+json" ,
            "application/rdf+xml" ,
            "text/anot+turtle" ,
            "text/turtle" ;
        sh:property [
            sh:path [
                sh:union (
                    [ shext:bNodeDepth "2" ]
                    shext:allPredicateValues
                    _:ricoInstantiationPath
                    ( _:ricoInstantiationPath rdf:type )
                    ( _:ricoInstantiationPath schema:name )
                    ( _:ricoInstantiationPath schema:description )
                    ( _:ricoInstantiationPath schema:identifier )
                    ( _:ricoInstantiationPath schema:location )
                    ( _:ricoInstantiationPath schema:materialExtent )
                    ( _:ricoInstantiationPath schema:dateCreated )
                    ( _:ricoInstantiationPath schema:dateModified )
                    ( _:ricoInstantiationPath rico:name )
                    ( _:ricoInstantiationPath rico:identifier )
                    ( _:ricoInstantiationPath rico:instantiationExtent )
                    ( _:ricoInstantiationPath rico:hasCollector )
                    ( _:ricoInstantiationPath rico:conditionsOfAccess )
                    ( _:ricoInstantiationPath rico:isAssociatedWithDate )
                    ( _:ricoInstantiationPath rico:isAssociatedWithDate rdf:type )
                    ( _:ricoInstantiationPath rico:isAssociatedWithDate rico:expressedDate )
                    ( _:ricoInstantiationPath rico:isAssociatedWithDate rico:beginningDate )
                    ( _:ricoInstantiationPath rico:isAssociatedWithDate rico:endDate )
                    ( _:ricoInstantiationPath rico:isAssociatedWithDate rico:dateQualifier )
                    ( _:ricoInstantiationPath rico:isAssociatedWithDate rico:normalizedDateValue )
                    ( _:ricoInstantiationPath rico:isAssociatedWithDate rico:hasBeginningDate )
                    ( _:ricoInstantiationPath rico:isAssociatedWithDate rico:hasBeginningDate rdf:type )
                    ( _:ricoInstantiationPath rico:isAssociatedWithDate rico:hasBeginningDate rico:expressedDate )
                    ( _:ricoInstantiationPath rico:isAssociatedWithDate rico:hasBeginningDate rico:dateQualifier )
                    ( _:ricoInstantiationPath rico:isAssociatedWithDate rico:hasBeginningDate rico:normalizedDateValue )
                    ( _:ricoInstantiationPath rico:isAssociatedWithDate rico:hasEndDate )
                    ( _:ricoInstantiationPath rico:isAssociatedWithDate rico:hasEndDate rdf:type )
                    ( _:ricoInstantiationPath rico:isAssociatedWithDate rico:hasEndDate rico:expressedDate )
                    ( _:ricoInstantiationPath rico:isAssociatedWithDate rico:hasEndDate rico:dateQualifier )
                    ( _:ricoInstantiationPath rico:isAssociatedWithDate rico:hasEndDate rico:normalizedDateValue )
                )
            ]
        ] ;
    .

    # odrl:Agreement rdfs:label "Agreement" .
    # odrl:permission rdfs:label "Has Permission" .
    # odrl:action rdfs:label "Has Action" .
    # odrl:assigner rdfs:label "Assigner" .
    # odrl:assignee rdfs:label "Assignee" .
    # odrl:target rdfs:label "Target" .

    # facet profiles

    prez:FacetProfile
        a prof:Profile, prez:ListingProfile, sh:NodeShape ;
        dcterms:title "Custom Facet Profile" ;
        dcterms:description "A custom facet profile for the IDN" ;
        dcterms:identifier "idn-facet"^^xsd:token ;
        sh:property [
            sh:path [
                sh:union (
                    rdf:type
                    schema:status
                    # [
                    #     sh:path ( [ sh:inversePath schema:hasPart ] ) ;
                    #     # sh:alternativePath
                    #     shext:pathAlias <https://example.com/alias/isPartOf> ;
                    # ]
                )
            ]
        ] ;
    .

    # <https://example.com/alias/isPartOf> rdfs:label "is part of" .
}
